# Neon DB 接続文字列（Vercel連携で自動付与される）
# 形式: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Zennユーザー名（省略時: myoshida2）
ZENN_USERNAME=myoshida2

# noteユーザー名（省略時: masa0416ab）
NOTE_USERNAME=masa0416ab

# Vercel Cron 認証用シークレット（Vercelの環境変数に設定する。ローカルでは不要）
# 生成例: openssl rand -hex 32
# 設定するとcronエンドポイントは Authorization: Bearer <CRON_SECRET> を要求する
CRON_SECRET=
